.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Firebase / Google credentials
google-services.json
GoogleService-Info.plist
service-account*.json
*-service-account.json


# ------------------------------------------------------------
