# ------------------------------------------------------------

.dart_tool/
.packages
.pub/
.pub-cache/

build/
.flutter-plugins
.flutter-plugins-dependencies

# Generated Flutter files
**/generated_plugin_registrant.dart

# Coverage
coverage/

# Flutter platform generated files
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Dart tooling
**/.dart_tool/
**/.packages


