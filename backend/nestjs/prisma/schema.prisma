generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  firebaseUid       String   @unique @db.VarChar(128)
  email             String?  @db.VarChar(320)
  displayName       String?  @db.VarChar(250)
  photoUrl          String?  @db.VarChar(1000)
  role              UserRole @default(USER)
  preferredLanguage String?  @db.VarChar(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  auditEvents       AuditLog[] @relation("AuditActor")
  auditedUserEvents AuditLog[] @relation("AuditTargetUser")

  @@index([role])
}

enum AuditAction {
  USER_ROLE_CHANGED
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  action       AuditAction
  actorUserId  String      @db.Uuid
  targetUserId String?     @db.Uuid
  fromRole     UserRole?
  toRole       UserRole?
  metadata     Json?
  createdAt    DateTime    @default(now())

  actor       User  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUser  User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model Language {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(10)
  name       String   @db.VarChar(100)
  nativeName String   @db.VarChar(100)
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  causeTranslations        CauseTranslation[]
  organisationTranslations OrganisationTranslation[]

  @@index([isActive])
}

model Cause {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(100)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations  CauseTranslation[]
  organisations OrganisationCause[]
  allocations   DonationAllocation[]
  beneficiaries Beneficiary[]

  @@index([isActive, displayOrder])
}

model CauseTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  causeId     String   @db.Uuid
  languageId  String   @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cause    Cause    @relation(fields: [causeId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([causeId, languageId])
  @@index([languageId])
}

model Organisation {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(120)
  logoUrl      String?  @db.VarChar(1000)
  websiteUrl   String?  @db.VarChar(1000)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(320)
  address      String?  @db.Text
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  country      String   @default("IN") @db.VarChar(2)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations  OrganisationTranslation[]
  causes        OrganisationCause[]
  allocations   DonationAllocation[]
  beneficiaries Beneficiary[]
  media         OrganisationMedia[]

  @@index([isActive, displayOrder])
  @@index([city, state])
}

model OrganisationTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  languageId     String   @db.Uuid
  name           String   @db.VarChar(250)
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  language     Language     @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([organisationId, languageId])
  @@index([languageId])
}

model OrganisationCause {
  id             String   @id @default(uuid())
  organisationId String   @db.Uuid
  causeId        String   @db.Uuid
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cause        Cause        @relation(fields: [causeId], references: [id], onDelete: Cascade)

  @@unique([organisationId, causeId])
  @@index([causeId, isActive, displayOrder])
  @@index([organisationId, isActive, displayOrder])
}

enum DonationStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
}

model Donation {
  id        String         @id @default(uuid()) @db.Uuid
  amount    Decimal        @db.Decimal(12, 2)
  currency  String         @default("INR") @db.VarChar(3)
  status    DonationStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  allocations DonationAllocation[]

  @@index([status, createdAt])
}

model DonationAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  donationId     String   @db.Uuid
  causeId        String   @db.Uuid
  organisationId String?  @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  donation     Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  cause        Cause         @relation(fields: [causeId], references: [id], onDelete: Restrict)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([causeId])
  @@index([organisationId])
}

model Beneficiary {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(250)
  photoUrl           String?  @db.VarChar(1000)
  story              String?  @db.Text
  supportedYear      Int
  contributionAmount Decimal  @db.Decimal(12, 2)
  causeId            String   @db.Uuid
  organisationId     String?  @db.Uuid
  isActive           Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cause        Cause              @relation(fields: [causeId], references: [id], onDelete: Restrict)
  organisation Organisation?      @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  media        BeneficiaryMedia[]

  @@index([causeId, isActive, displayOrder])
  @@index([supportedYear, isActive])
  @@index([name])
}

model Media {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @unique @db.VarChar(1000)
  mimeType   String   @db.VarChar(100)
  fileSize   Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisationMedia OrganisationMedia[]
  beneficiaryMedia  BeneficiaryMedia[]
}

enum OrganisationMediaPurpose {
  LOGO
  GALLERY
}

model OrganisationMedia {
  id             String                   @id @default(uuid()) @db.Uuid
  organisationId String                   @db.Uuid
  mediaId        String                   @db.Uuid
  purpose        OrganisationMediaPurpose @default(GALLERY)
  displayOrder   Int                      @default(0)
  isPrimary      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  media        Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([organisationId, mediaId])
  @@index([organisationId, purpose, displayOrder])
  @@index([mediaId])
}

enum BeneficiaryMediaPurpose {
  PROFILE
  GALLERY
}

model BeneficiaryMedia {
  id            String                  @id @default(uuid()) @db.Uuid
  beneficiaryId String                  @db.Uuid
  mediaId       String                  @db.Uuid
  purpose       BeneficiaryMediaPurpose @default(GALLERY)
  displayOrder  Int                     @default(0)
  isPrimary     Boolean                 @default(false)
  createdAt     DateTime                @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryId, mediaId])
  @@index([beneficiaryId, purpose, displayOrder])
  @@index([mediaId])
}

model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @db.VarChar(64)
  sessionId       String   @db.VarChar(64)
  eventName      String   @db.VarChar(64)
  screenName      String?  @db.VarChar(64)
  interactionType String?  @db.VarChar(32)
  target          String?  @db.VarChar(128)
  city            String?  @db.VarChar(100)
  language        String?  @db.VarChar(10)
  deviceType      String?  @db.VarChar(32)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventName, createdAt])
  @@index([screenName, createdAt])
  @@index([city, createdAt])
  @@index([language, createdAt])
  @@index([deviceType, createdAt])
}
